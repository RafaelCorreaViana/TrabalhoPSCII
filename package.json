{
  "name": "sporthub",
  "version": "1.0.0",
  "description": "SportHub Monorepo",
  "scripts": {
    "dev": "npx concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client && npm run build --prefix server",
    "start": "npm run start --prefix server",
    "prepare": "husky"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "author": "Rafael",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7"
  },
  "overrides": {
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3"
  }
}
